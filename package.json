{
  "name": "zenit-pos-backend",
  "version": "1.0.0",
  "description": "Backend API para Zenit POS",
  "main": "server.js",
  "scripts": {
    "start": "npx sequelize-cli db:migrate && node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:status": "npx sequelize-cli db:migrate:status",
    "probar:postgres": "node pruebas-postgres/correr.js",
    "test:pg": "node pruebas-postgres/correr-jest.js",
    "verificar": "npm test && npm run test:pg && npm run probar:postgres && npm run probar:arranque",
    "probar:arranque": "node pruebas-postgres/probar-arranque.js"
  },
  "dependencies": {
    "@sentry/node": "^10.45.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "sequelize": "^6.35.0",
    "stripe": "^20.4.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "embedded-postgres": "^17.10.0-beta.17",
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
